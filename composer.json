{
    "name": "admin/mydaily",
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Admin\\Mydaily\\": "src/"
        }
    },
    "authors": [
        {
            "name": "asddd7",
            "email": "adipatisuryadimyati@gmail.com"
        }
    ],
    "require": {
        "phpoffice/phpspreadsheet": "^1.30.6",
